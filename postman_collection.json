{
  "info": {
    "name": "Library Management System API",
    "description": "Postman Collection for student full-stack Library Management System with Django REST Framework",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/dashboard-stats/",
              "host": ["{{baseUrl}}"],
              "path": ["issues", "dashboard-stats", ""]
            }
          }
        }
      ]
    },
    {
